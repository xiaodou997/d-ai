{
  "name": "@dai/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "由各后端服务的 OpenAPI 契约生成的 TypeScript 类型（运行时 client 见 T4.2）",
  "exports": {
    ".": "./src/index.ts",
    "./ai": "./src/ai.ts",
    "./urm": "./src/urm.ts",
    "./proxy": "./src/proxy.ts"
  },
  "types": "./src/index.ts",
  "main": "src/index.ts",
  "scripts": {
    "generate": "node scripts/generate.mjs --generate",
    "ensure": "node scripts/generate.mjs --ensure"
  }
}
