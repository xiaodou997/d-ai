DAI_DATABASE_PASSWORD=replace-with-a-url-safe-random-password
DAI_IMAGE_TAG=544be6d19053-originfix1
# 必须填入原 URM 实际密钥；该密钥同时用于新 AI 敏感配置加密
DAI_SECURITY_SECRET_MASTER_KEY=preserve-from-unihub
# 对外访问的固定 origin；生产环境不可省略，且必须使用 HTTPS
DAI_PUBLIC_BASE_URL=https://portal.example.com
# 仅填写直接连接 D-AI 的反向代理网段，例如本机 Nginx
DAI_TRUSTED_PROXY_CIDRS=127.0.0.1/32
