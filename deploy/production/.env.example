DAI_DATABASE_PASSWORD=replace-with-a-url-safe-random-password
DAI_BILLING_DATABASE_PASSWORD=replace-with-a-separate-url-safe-random-password
DAI_IMAGE_TAG=544be6d19053-originfix1
# 管理探针/metrics 仅绑定容器回环；若需 Prometheus 访问，请通过受控管理网络覆盖
DAI_SERVER_MANAGEMENT_ADDR=127.0.0.1:19642
DAI_SERVER_MAX_BODY_BYTES=67108864
DAI_SERVER_MAX_HEADER_BYTES=32768
# 必须填入高熵随机密钥；该密钥同时用于 JWT、URM/AI 敏感配置加密
DAI_SECURITY_SECRET_MASTER_KEY=preserve-from-unihub
# 轮换时修改 ID，并将旧值以 keyID=key 放入 previous，保留至所有实例完成迁移
DAI_SECURITY_SECRET_MASTER_KEY_ID=v1
DAI_SECURITY_SECRET_MASTER_KEY_PREVIOUS=
# OAuth token refresh client secrets are intentionally not bundled; provide
# them through the deployment secret manager when Gemini/Antigravity refresh is enabled.
GEMINI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
# 对外访问的固定 origin；生产环境不可省略，且必须使用 HTTPS
DAI_PUBLIC_BASE_URL=https://portal.example.com
# 仅填写直接连接 D-AI 的反向代理网段，例如本机 Nginx
DAI_TRUSTED_PROXY_CIDRS=127.0.0.1/32
