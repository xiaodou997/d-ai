{
  "name": "dai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "D-AI — 统一 AI 服务（单后端 + 单 Portal，单二进制部署）",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev:frontend": "vite --config apps/portal/vite.config.ts",
    "build:frontend": "node apps/portal/scripts/validate-portal-architecture.mjs && vite build --config apps/portal/vite.config.ts && node apps/portal/scripts/validate-built-styles.mjs",
    "validate:portal-architecture": "node apps/portal/scripts/validate-portal-architecture.mjs",
    "validate:frontend-styles": "node apps/portal/scripts/validate-built-styles.mjs",
    "generate:api": "node apps/portal/scripts/generate.mjs --generate",
    "ensure:api": "node apps/portal/scripts/generate.mjs --ensure",
    "typecheck": "vue-tsc --noEmit -p apps/portal/tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "dompurify": "^3.4.12",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.3",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.6",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "3.5.39",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "happy-dom": "20.8.3",
    "openapi-typescript": "7.10.1",
    "postcss": "^8.5.16",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.4",
    "vitest": "4.0.18",
    "vue-tsc": "^3.3.7"
  }
}
