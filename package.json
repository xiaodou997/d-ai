{
  "name": "dai",
  "version": "0.1.0",
  "private": true,
  "description": "D-AI — 统一 AI 服务（单后端 + 单前端，单二进制部署）",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@element-plus/icons-vue": "^2.3.2",
      "@tailwindcss/vite": "^4.3.2",
      "@vitejs/plugin-vue": "^6.0.7",
      "echarts": "^6.1.0",
      "element-plus": "^2.14.3",
      "dompurify": "^3.4.12",
      "lucide-vue-next": "^1.0.0",
      "marked": "^18.0.6",
      "pinia": "^3.0.4",
      "qrcode": "^1.5.4",
      "tailwindcss": "^4.3.2",
      "typescript": "^6.0.3",
      "vite": "^8.1.4",
      "vue": "^3.5.39",
      "vue-router": "^5.1.0",
      "vue-sonner": "^2.0.9",
      "vue-tsc": "^3.3.7"
    }
  },
  "scripts": {
    "dev:frontend": "bun run --filter @dai/portal dev",
    "build:frontend": "bun run --filter @dai/portal build",
    "typecheck": "bun run --filter @dai/portal typecheck",
    "test": "vitest run"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vue/compiler-sfc": "3.5.39",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "happy-dom": "20.8.3",
    "openapi-typescript": "7.10.1",
    "postcss": "^8.5.16",
